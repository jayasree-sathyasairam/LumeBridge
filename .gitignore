# ── Maven / Java ────────────────────────────────────────────────
**/target/
**/*.class
*.jar
*.war
*.ear
.mvn/wrapper/maven-wrapper.jar

# ── Infrastructure / Docker ─────────────────────────────────────
# Ignore persistent data volumes
**/postgres-data/
**/redis-data/
**/redpanda-data/

# ── Logs & Temporary Files ──────────────────────────────────────
*.log
/tmp/
.DS_Store
Thumbs.db

# ── IDEs ────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.swp
*.swo

# ── Benchmarks & Reports ────────────────────────────────────────
# Keep the report templates but ignore the raw results if they are large
/reports/*.json
/reports/k6_stress_audit_snapshot.md
# Written by scripts/bench-runner.sh (Version 1 k6 summary table); regenerate locally.
/benchmarks/*.json
/benchmarks/stress_report.md
experience-bridge.md

# ── Cursor / local prompts ────────────────────────────────────────
.cursor/rules/
prompt.md
**/prompt.md

# ── Screenshots & Local Documentation ────────────────────────────
# Ignore screenshots and local quality check documents
*screenshot*.png
*screenshot*.jpg
*screenshot*.jpeg
*screenshot*.gif
CODE_IMPROVEMENTS.md

# ── Configuration & Secrets ──────────────────────────────────────
.env
lumebridge.yaml
