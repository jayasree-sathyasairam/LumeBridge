# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Postgres
POSTGRES_USER=lumebridge
POSTGRES_PASSWORD=lumebridge
POSTGRES_DB=lumebridge_nexus
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional: full JDBC URL (overrides host/port/db when set)
# JDBC_URL=jdbc:postgresql://localhost:5432/lumebridge_nexus

# Redpanda (Kafka-compatible)
REDPANDA_KAFKA_PORT=19092
REDPANDA_SCHEMA_PORT=18081
REDPANDA_ADMIN_PORT=9644

# Gateway
PORT=8080
THROTTLE_PERMITS=10
WORK_DELAY_MS=200
LOCK_TTL_SECONDS=30

# Kafka / DLQ (when plugins.dlq.enabled in lumebridge.yaml)
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
DLQ_TOPIC=lumebridge-dlq
